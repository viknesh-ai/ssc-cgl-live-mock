{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL'",
        "candidates": {
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL')",
            ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL')"
          }
        }
      }
    }
  }
}
