# Postgres. On Railway add the Postgres plugin and set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ssc_cgl?schema=public"

# The one Google account allowed to run exams
EXAMINER_EMAIL="jeyaviknesh@gmail.com"

# Firebase web app (Authentication -> Google sign-in must be enabled)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# Server-side token verification (defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=""

# EURI, used for post-test answer explanations
EURI_API_KEY=""
EURI_MODEL="gemini-2.5-pro"
EURI_BASE_URL="https://api.euron.one/api/v1/euri"

# Optional TURN relay, for camera streaming through restrictive networks
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""
